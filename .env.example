# DadStats — copy to .env and fill in, or just leave everything blank and `docker run` it: a
# missing JWT_SECRET is generated on first boot and persisted to the data volume.

# --- App server ---
PORT=3211
TZ=America/New_York

# --- Sessions ---
# Optional — auto-generated into <data dir>/.jwt_secret on first boot if left blank.
JWT_SECRET=

# --- Admin (creates families and sets their passwords, at /admin) ---
# Optional — if blank, one is generated on first boot, printed to the container logs, and saved
# to <data dir>/.admin_password. Set it here to choose your own.
ADMIN_PASSWORD=

# How many proxies sit in front of this app. Without it every request looks like it came from
# the proxy, so the login rate limit becomes global — one person mistyping their password would
# lock out everyone.
#   1     one reverse proxy (nginx, Caddy, Nginx Proxy Manager, Traefik)
#   2     two hops, e.g. Cloudflare in front of your own reverse proxy
#   true  trust the whole X-Forwarded-For chain. Only if you control every hop: the left-most
#         entry is whatever the visitor sent, so this lets a client forge its own address.
TRUST_PROXY=

# Usually leave this blank. The session cookie is marked `Secure` automatically on any request
# that arrived over HTTPS (which needs TRUST_PROXY set when TLS is terminated at a proxy), so
# one instance can serve a public HTTPS address and a plain-HTTP LAN address correctly.
# Set to 1 to force the flag on for every response — only when *every* way in is HTTPS, since
# browsers refuse to send a Secure cookie back over plain HTTP and login then fails silently.
SECURE_COOKIES=

# --- SQLite ---
# Path to the database file. Point this at a mounted volume so data survives container restarts.
SQLITE_PATH=/app/data/dadstats.db
